  public class ReportScript
  {

    private void DepartmenName_BeforePrint(object sender, EventArgs e)
    {
      TextObject txt = sender as TextObject;
      object value = Report.GetColumnValue(&quot;ReportSWOTAnalysisDto.DepartmentName&quot;);

      // Set text
      if (value != null &amp;&amp; !string.IsNullOrWhiteSpace(value.ToString()))
      {
        txt.Text = value.ToString().ToUpper();       
      }
      else
      {
        txt.Text = &quot;&quot;;      
      }
    }
  }
}
</ScriptText>
